---
import BaseLayout from "../../layouts/BaseLayout.astro";

const error = Astro.url.searchParams.get("error");

const messages: Record<string, string> = {
  invalid_input: "Ingresa un correo válido y una contraseña de al menos 8 caracteres.",
  invalid_credentials: "El correo o la contraseña no son correctos.",
  unauthorized: "Esta cuenta no tiene acceso al panel administrativo.",
};

const errorMessage = error ? messages[error] : undefined;

if (Astro.locals.user) {
  return Astro.redirect("/admin");
}
---

<BaseLayout title="Acceso administrativo | Alma Esencia CR">
  <main class="mx-auto flex min-h-screen max-w-5xl items-center px-4 py-12 sm:px-8">
    <section class="w-full max-w-md rounded-[20px] border border-border-subtle bg-surface-card p-6 shadow-[0_12px_28px_-4px_rgba(134,54,93,0.10)] sm:p-8">
      <p class="text-xs font-semibold tracking-[0.14em] text-brand-primary uppercase">
        Alma Esencia CR
      </p>
      <h1 class="mt-3 font-display text-3xl font-semibold text-text-primary">
        Panel administrativo
      </h1>
      <p class="mt-3 text-sm leading-6 text-text-secondary">
        Ingresa con el correo y la contraseña autorizados para gestionar el catálogo y los pedidos.
      </p>

      {
        errorMessage && (
          <div class="mt-6 border-l-[3px] border-brand-primary bg-brand-primary-soft px-4 py-3 text-sm leading-6 text-text-primary" role="alert">
            {errorMessage}
          </div>
        )
      }

      <form class="mt-6 space-y-5" method="post" action="/api/admin/sign-in">
        <div>
          <label class="mb-2 block text-sm font-semibold text-text-primary" for="email">
            Correo electrónico
          </label>
          <input
            class="min-h-11 w-full rounded-lg border border-border-subtle bg-white px-3 text-sm text-text-primary outline-none transition focus:border-brand-primary focus:ring-3 focus:ring-brand-primary/12"
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </div>

        <div>
          <label class="mb-2 block text-sm font-semibold text-text-primary" for="password">
            Contraseña
          </label>
          <input
            class="min-h-11 w-full rounded-lg border border-border-subtle bg-white px-3 text-sm text-text-primary outline-none transition focus:border-brand-primary focus:ring-3 focus:ring-brand-primary/12"
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            minlength="8"
            required
          />
        </div>

        <button class="min-h-11 w-full rounded-full bg-brand-primary px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-primary-hover" type="submit">
          Ingresar al panel
        </button>
      </form>
    </section>
  </main>
</BaseLayout>
