---
import OrderManager from "../../components/admin/OrderManager";
import AdminPushSettings from "../../components/admin/AdminPushSettings";
import AdminSidebar from "../../components/admin/AdminSidebar.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect("/admin/login");

const { data: profile } = await supabase.from("profiles").select("role").eq("id", user.id).maybeSingle();
if (profile?.role !== "admin") {
  await supabase.auth.signOut();
  return Astro.redirect("/admin/login?error=unauthorized");
}

const [ordersResult, itemsResult, paymentsResult, historyResult] = await Promise.all([
  supabase.from("orders").select("id, order_number, customer_name, customer_phone, estimated_total, confirmed_total, confirmed_at, currency, order_status, procurement_status, fulfillment_status, payment_status, admin_notes, created_at").order("created_at", { ascending: false }),
  supabase.from("order_items").select("id, order_id, product_name_snapshot, quantity, stock_deducted_quantity, unit_price_snapshot, availability_snapshot"),
  supabase.from("order_payments").select("id, order_id, amount, payment_method, note, received_at").order("received_at", { ascending: false }),
  supabase.from("order_status_history").select("id, order_id, status_type, previous_value, next_value, note, created_at, changed_by").order("created_at", { ascending: false }),
]);
let items = itemsResult.data;
let itemsError = itemsResult.error;
if (itemsError && ["42703", "PGRST204"].includes(itemsError.code)) {
  const fallback = await supabase.from("order_items").select("id, order_id, product_name_snapshot, quantity, unit_price_snapshot, availability_snapshot");
  items = (fallback.data ?? []).map((item) => ({ ...item, stock_deducted_quantity: null }));
  itemsError = fallback.error;
}
const ordersLoadError = ordersResult.error || itemsError || paymentsResult.error || historyResult.error;
if (ordersLoadError) {
  console.error("No fue posible cargar los datos administrativos de pedidos", {
    orders: ordersResult.error ? { code: ordersResult.error.code, message: ordersResult.error.message } : null,
    items: itemsError ? { code: itemsError.code, message: itemsError.message } : null,
    payments: paymentsResult.error ? { code: paymentsResult.error.code, message: paymentsResult.error.message } : null,
    history: historyResult.error ? { code: historyResult.error.code, message: historyResult.error.message } : null,
  });
}

const orders = (ordersResult.data ?? []).map((order) => ({
  ...order,
  items: (items ?? []).filter((item) => item.order_id === order.id),
  payments: (paymentsResult.data ?? []).filter((payment) => payment.order_id === order.id),
  history: (historyResult.data ?? []).filter((change) => change.order_id === order.id),
}));
const pendingReviewCount = ordersResult.error
  ? null
  : (ordersResult.data ?? []).filter((order) => order.order_status === "pending_review").length;
---

<BaseLayout title="Pedidos | Alma Esencia CR" adminApp>
  <div class="min-h-screen lg:grid lg:grid-cols-[15rem_minmax(0,1fr)]">
    <AdminSidebar active="orders" pendingReviewCount={pendingReviewCount} />
    <main class="min-w-0 px-4 pt-10 pb-28 sm:px-8 md:py-10 lg:px-10 xl:px-14">
    <header class="border-b border-border-subtle pb-7">
      <div>
        <p class="text-xs font-semibold tracking-[0.14em] text-brand-primary uppercase">Alma Esencia CR</p>
        <h1 class="mt-3 font-display text-3xl font-semibold text-text-primary sm:text-4xl">Pedidos</h1>
        <p class="mt-2 text-sm leading-6 text-text-secondary">Revisa solicitudes, coordina disponibilidad y actualiza su avance.</p>
      <div class="mt-6"><AdminPushSettings client:load /></div>
      </div>
    </header>
    {ordersLoadError ? (
      <p class="mt-10 rounded-xl border border-border-subtle bg-surface-soft p-5 text-sm text-text-primary" role="alert">
        No fue posible cargar los pedidos. Recarga la página e inténtalo de nuevo.
      </p>
    ) : (
      <OrderManager client:load initialOrders={orders} />
    )}
  </main>
  </div>
</BaseLayout>
