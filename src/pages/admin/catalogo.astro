---
import CatalogManager from "../../components/admin/CatalogManager";
import InventoryManager from "../../components/admin/InventoryManager";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAdminCatalogData, getAdminInventoryData } from "../../services/admin-catalog";

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect("/admin/login");
const { data: profile } = await supabase.from("profiles").select("role").eq("id", user.id).maybeSingle();
if (profile?.role !== "admin") {
  await supabase.auth.signOut();
  return Astro.redirect("/admin/login?error=unauthorized");
}
const [{ categories, products }, inventory] = await Promise.all([getAdminCatalogData(supabase), getAdminInventoryData(supabase)]);
---

<BaseLayout title="Catálogo e inventario | Alma Esencia CR">
  <main class="min-h-screen w-full px-4 py-10 sm:px-8 lg:px-10 xl:px-14">
    <header class="flex flex-col gap-5 border-b border-border-subtle pb-7 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="text-xs font-semibold tracking-[0.14em] text-brand-primary uppercase">Alma Esencia CR</p><h1 class="mt-3 font-display text-3xl font-semibold text-text-primary sm:text-4xl">Catálogo e inventario</h1></div>
      <div class="flex flex-wrap gap-2"><a class="inline-flex min-h-11 items-center rounded-full border-[1.5px] border-brand-primary px-5 text-sm font-semibold text-brand-primary hover:bg-brand-primary-soft" href="/admin">Pedidos</a><a class="inline-flex min-h-11 items-center rounded-full bg-brand-primary px-5 text-sm font-semibold text-white" href="/admin/catalogo">Catálogo e inventario</a><form method="post" action="/api/admin/sign-out"><button class="min-h-11 rounded-full px-4 text-sm font-semibold text-brand-primary hover:bg-brand-primary-soft" type="submit">Cerrar sesión</button></form></div>
    </header>
    <div class="mt-10"><CatalogManager client:load initialCategories={categories} initialProducts={products} /><InventoryManager client:load initialInventory={inventory} products={products} categories={categories} /></div>
  </main>
</BaseLayout>
