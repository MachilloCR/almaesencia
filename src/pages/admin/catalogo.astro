---
import CatalogManager from "../../components/admin/CatalogManager";
import AdminSidebar from "../../components/admin/AdminSidebar.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAdminCatalogData, getAdminInventoryData } from "../../services/admin-catalog";

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect("/admin/login");
const { data: profile } = await supabase.from("profiles").select("role").eq("id", user.id).maybeSingle();
if (profile?.role !== "admin") {
  await supabase.auth.signOut();
  return Astro.redirect("/admin/login?error=unauthorized");
}
const [{ categories, products }, inventory, pendingOrdersResult] = await Promise.all([
  getAdminCatalogData(supabase),
  getAdminInventoryData(supabase),
  supabase.from("orders").select("id", { count: "exact", head: true }).eq("order_status", "pending_review"),
]);
if (pendingOrdersResult.error) {
  console.error("No fue posible consultar los pedidos pendientes de revisión", {
    code: pendingOrdersResult.error.code,
    message: pendingOrdersResult.error.message,
  });
}
const pendingReviewCount = pendingOrdersResult.error ? null : pendingOrdersResult.count;
---

<BaseLayout title="Catálogo | Alma Esencia CR" adminApp>
  <div class="min-h-screen lg:grid lg:grid-cols-[15rem_minmax(0,1fr)]">
    <AdminSidebar active="catalog" pendingReviewCount={pendingReviewCount} />
    <main class="min-w-0 px-4 pt-10 pb-28 sm:px-8 md:py-10 lg:px-10 xl:px-14">
      <header class="border-b border-border-subtle pb-7">
        <p class="text-xs font-semibold tracking-[0.14em] text-brand-primary uppercase">Alma Esencia CR</p>
        <h1 class="mt-3 font-display text-3xl font-semibold text-text-primary sm:text-4xl">Catálogo</h1>
        <p class="mt-2 text-sm leading-6 text-text-secondary">Administra productos, categorías y existencias en un solo lugar.</p>
      </header>
      <div class="mt-10">
        <CatalogManager client:load initialCategories={categories} initialProducts={products} initialInventory={inventory} />
      </div>
    </main>
  </div>
</BaseLayout>
