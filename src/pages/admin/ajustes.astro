---
import AdminPushSettings from "../../components/admin/AdminPushSettings";
import AdminAppearanceSelector from "../../components/admin/AdminAppearanceSelector.astro";
import AdminSidebar from "../../components/admin/AdminSidebar.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect("/admin/login");

const { data: profile } = await supabase.from("profiles").select("role").eq("id", user.id).maybeSingle();
if (profile?.role !== "admin") {
  await supabase.auth.signOut();
  return Astro.redirect("/admin/login?error=unauthorized");
}

const pendingOrdersResult = await supabase.from("orders").select("id", { count: "exact", head: true }).eq("order_status", "pending_review");
if (pendingOrdersResult.error) {
  console.error("No fue posible consultar los pedidos pendientes de revisión", {
    code: pendingOrdersResult.error.code,
    message: pendingOrdersResult.error.message,
  });
}
const pendingReviewCount = pendingOrdersResult.error ? null : pendingOrdersResult.count;
---

<BaseLayout title="Ajustes | Alma Esencia CR" adminApp>
  <div class="min-h-screen lg:grid lg:grid-cols-[15rem_minmax(0,1fr)]">
    <AdminSidebar active="settings" pendingReviewCount={pendingReviewCount} />
    <main class="min-w-0 px-4 pt-10 pb-28 sm:px-8 md:py-10 lg:px-10 xl:px-14">
      <header class="border-b border-border-subtle pb-7">
        <p class="text-xs font-semibold tracking-[0.14em] text-brand-primary uppercase">Alma Esencia CR</p>
        <h1 class="mt-3 font-display text-3xl font-semibold text-text-primary sm:text-4xl">Ajustes</h1>
        <p class="mt-2 text-sm leading-6 text-text-secondary">Configuración de la aplicación y de este dispositivo.</p>
      </header>
      <section class="mt-8 max-w-3xl rounded-2xl border border-border-subtle bg-surface-card p-4 shadow-[0_4px_20px_-2px_rgba(134,54,93,0.05)] sm:p-5">
        <h2 class="font-display text-2xl font-semibold text-text-primary">Apariencia del panel</h2>
        <p class="mt-2 text-sm leading-6 text-text-secondary">Elige el tema claro, oscuro o el que utiliza este dispositivo. La preferencia se guarda solo en este dispositivo.</p>
        <AdminAppearanceSelector />
      </section>
      <section class="mt-8 max-w-3xl">
        <h2 class="mb-3 font-display text-2xl font-semibold text-text-primary">Aplicación y avisos</h2>
        <AdminPushSettings client:load />
      </section>
    </main>
  </div>
</BaseLayout>
