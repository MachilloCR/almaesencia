---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="mx-auto flex min-h-screen max-w-5xl items-center px-4 py-16 sm:px-8">
    <section class="max-w-2xl">
      <p class="mb-4 text-xs font-semibold tracking-[0.14em] text-brand-primary uppercase">
        Catálogo artesanal · Costa Rica
      </p>
      <h1 class="font-display text-4xl leading-tight font-semibold text-text-primary sm:text-6xl">
        Alma Esencia CR
      </h1>
      <p class="mt-6 max-w-xl text-base leading-7 text-text-secondary">
        Estamos preparando un catálogo para descubrir piezas especiales y enviar solicitudes de pedido de manera personalizada.
      </p>
    </section>
  </main>
</BaseLayout>
