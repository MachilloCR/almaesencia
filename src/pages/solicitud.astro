---
import RequestCart from "../components/catalog/RequestCart";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Mi solicitud | Alma Esencia CR">
  <header class="border-b border-border-subtle bg-surface/95">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-5 sm:px-8 lg:px-12">
      <a class="font-display text-2xl font-semibold text-text-primary" href="/">Alma Esencia CR</a>
      <a class="text-sm font-semibold text-brand-primary hover:underline" href="/">Seguir explorando</a>
    </nav>
  </header>
  <main class="mx-auto min-h-screen max-w-7xl px-4 py-12 sm:px-8 lg:px-12">
    <RequestCart client:load />
  </main>
</BaseLayout>
