<fieldset class="mt-3 min-w-0" aria-label="Apariencia administrativa">
  <legend class="mb-1.5 text-xs font-semibold text-text-secondary">Apariencia</legend>
  <div class="inline-flex max-w-full rounded-xl border border-border-subtle bg-surface-card p-1">
    <label class="cursor-pointer rounded-lg">
      <input class="peer sr-only" type="radio" name="admin-theme-preference" value="light" />
      <span class="inline-flex min-h-11 min-w-11 items-center justify-center gap-1.5 rounded-lg px-2.5 text-xs font-semibold text-text-secondary transition hover:bg-brand-primary-soft peer-checked:bg-brand-primary-soft peer-checked:text-brand-primary peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-primary sm:px-3">
        <svg aria-hidden="true" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
        <span class="sr-only sm:not-sr-only lg:sr-only">Claro</span>
      </span>
    </label>
    <label class="cursor-pointer rounded-lg">
      <input class="peer sr-only" type="radio" name="admin-theme-preference" value="dark" />
      <span class="inline-flex min-h-11 min-w-11 items-center justify-center gap-1.5 rounded-lg px-2.5 text-xs font-semibold text-text-secondary transition hover:bg-brand-primary-soft peer-checked:bg-brand-primary-soft peer-checked:text-brand-primary peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-primary sm:px-3">
        <svg aria-hidden="true" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" /></svg>
        <span class="sr-only sm:not-sr-only lg:sr-only">Oscuro</span>
      </span>
    </label>
    <label class="cursor-pointer rounded-lg">
      <input class="peer sr-only" type="radio" name="admin-theme-preference" value="system" checked />
      <span class="inline-flex min-h-11 min-w-11 items-center justify-center gap-1.5 rounded-lg px-2.5 text-xs font-semibold text-text-secondary transition hover:bg-brand-primary-soft peer-checked:bg-brand-primary-soft peer-checked:text-brand-primary peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-primary sm:px-3">
        <svg aria-hidden="true" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8m-4-4v4" /></svg>
        <span class="sr-only sm:not-sr-only lg:sr-only">Automático</span>
      </span>
    </label>
  </div>
</fieldset>

<script is:inline>
  const preference = document.documentElement.dataset.adminThemePreference;
  const radios = document.querySelectorAll('input[name="admin-theme-preference"]');

  for (const radio of radios) {
    radio.checked = radio.value === preference;
  }
</script>
