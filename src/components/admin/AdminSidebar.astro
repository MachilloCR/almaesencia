---
interface Props {
  active: "orders" | "catalog";
  pendingReviewCount: number | null;
}

const { active, pendingReviewCount } = Astro.props;
const linkClass = (isActive: boolean) =>
  isActive
    ? "bg-brand-primary text-white"
    : "text-text-secondary hover:bg-brand-primary-soft hover:text-brand-primary";
---

<aside class="flex items-center justify-between gap-3 border-b border-border-subtle bg-gradient-to-t from-brand-primary/25 via-brand-primary-soft to-surface-card px-4 py-4 lg:sticky lg:top-0 lg:h-screen lg:self-start lg:flex-col lg:items-stretch lg:border-r lg:border-b-0 lg:px-5 lg:py-8">
  <div class="min-w-0 lg:flex lg:flex-1 lg:flex-col">
    <a class="block" href="/admin" aria-label="Alma Esencia CR, pedidos">
      <img class="h-10 w-auto object-contain lg:h-16" src="/logo-almaesencia.png" alt="Alma Esencia CR" />
    </a>
    <p class="mt-1 hidden text-xs font-semibold tracking-[0.14em] text-brand-primary uppercase lg:block">Administración</p>
    <nav class="mt-4 hidden gap-2 overflow-x-auto scrollbar-none md:flex lg:flex-col" aria-label="Navegación administrativa">
      <a
        class={`inline-flex min-h-11 shrink-0 items-center rounded-xl px-4 text-sm font-semibold transition ${linkClass(active === "orders")}`}
        href="/admin"
        aria-current={active === "orders" ? "page" : undefined}
      >Pedidos</a>
      <a
        class={`inline-flex min-h-11 shrink-0 items-center rounded-xl px-4 text-sm font-semibold transition ${linkClass(active === "catalog")}`}
        href="/admin/catalogo"
        aria-current={active === "catalog" ? "page" : undefined}
      >Catálogo e inventario</a>
    </nav>
  </div>
  <form class="shrink-0 lg:mt-auto lg:w-full" method="post" action="/api/admin/sign-out">
    <button class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-xl px-3 text-sm font-semibold text-brand-primary transition hover:bg-brand-primary-soft lg:w-full lg:justify-start lg:px-4" type="submit">
      <svg aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6A2.25 2.25 0 0 0 5.25 5.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m-6-3h9m0 0-3-3m3 3-3 3" />
      </svg>
      <span>Cerrar sesión</span>
    </button>
  </form>
</aside>
<nav class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-border-subtle bg-surface-card px-4 pt-2 pb-[calc(env(safe-area-inset-bottom)+0.5rem)] md:hidden" aria-label="Navegación administrativa móvil">
  <a
    class={`inline-flex min-h-14 flex-col items-center justify-center gap-1 text-xs font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brand-primary ${active === "orders" ? "text-brand-primary" : "text-text-secondary"}`}
    href="/admin"
    aria-current={active === "orders" ? "page" : undefined}
    aria-label={pendingReviewCount === null ? "Pedidos" : `Pedidos, ${pendingReviewCount} pendientes de revisión`}
  >
    <svg aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="12" height="17" rx="2" /><path d="M9 4.5V3h6v1.5M9 9h6m-6 4h6m-6 4h3" /></svg>
    <span class="inline-flex items-center gap-1.5">Pedidos{pendingReviewCount !== null && pendingReviewCount > 0 && <span class="inline-flex min-h-4 min-w-4 items-center justify-center rounded-full bg-brand-primary px-1 text-[10px] font-bold leading-3 text-white">{pendingReviewCount > 99 ? "99+" : pendingReviewCount}</span>}</span>
  </a>
  <a
    class={`inline-flex min-h-14 flex-col items-center justify-center gap-1 text-xs font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brand-primary ${active === "catalog" ? "text-brand-primary" : "text-text-secondary"}`}
    href="/admin/catalogo"
    aria-current={active === "catalog" ? "page" : undefined}
  >
    <svg aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z" /><path d="m4.5 7.8 7.5 4.3 7.5-4.3M12 12.1V21m-4-15.8 8 4.5" /></svg>
    <span>Inventario</span>
  </a>
</nav>
